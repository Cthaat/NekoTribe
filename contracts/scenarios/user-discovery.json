      "meta": {
        "page": 2,
        "page_size": 2,
        "total": 8,
        "has_next": true
      }
    },
    {
      "id": "duplicate-queries-fall-back",
      "path": "/api/v2/users?q=a&q=b&verified=true&verified=false&sort=oldest&sort=newest&page=3&page=2",
      "status": 200,
      "pattern": "%%",
      "sort": "popular",
      "verified": 0,
      "meta": {
        "page": 1,
        "page_size": 20,
        "total": 8,
        "has_next": false
      }
    },
    {
      "id": "empty-page-keeps-total",
      "path": "/api/v2/users?q=Test&sort=newest&page=10001&page_size=999",
      "status": 200,
