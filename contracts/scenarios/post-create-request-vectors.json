{
  "id": "POST-CREATE-REQUEST-VECTORS",
  "revision": 1,
  "scope": "Authenticated request parsing and pre-write validation for POST /api/v2/posts and POST /api/v2/posts/:id/retweets. Successful cases assume usable referenced entities and a successful repository stub; normalized input precedes relationship deduplication and caps.",
