      "route": "create",
      "body": {
        "content": "hello"
      },
      "expected": {
        "status": 200,
        "code": 200,
        "message": "post created",
        "post_type": "post",
        "input": {
          "content": "hello",
          "visibility": "public",
          "location": "",
          "media_ids": [],
          "tag_names": [],
          "mention_user_ids": [],
          "reply_to_post_id": null,
          "repost_of_post_id": null,
          "quoted_post_id": null
        }
      }
    },
