{
  "id": "GLOBAL-SEARCH-V2",
  "revision": 2,
  "cases": [
    {"id":"sections","given":{"posts":["2:cat","10:cat","1:cats"],"tags":["cat"]},"when":"guest search cat limit=2","expect":{"posts":["2","10"],"counts":{"posts":3,"users":0,"groups":0,"tags":1},"cursor":true}},
    {"id":"continuation","given":{"previous":"sections","issuer":"nuxt"},"when":"go or rust next page limit=2","expect":{"posts":["1"],"tags":["cat"],"cursor":null}},
    {"id":"filter","given":{"posts":["2:cat"],"tags":["cat"]},"when":"search type=tags q=cat","expect":{"ids":["cat"],"counts":{"posts":0,"users":0,"groups":0,"tags":1}}},
    {"id":"highlights","given":{"label":"🐈Cat猫CAT"},"when":"search q=cat","expect":{"highlights":[[1,4],[5,8]]}},
    {"id":"normalization","given":{"stored":"Café"},"when":"search q= Cafe\u0301 with ASCII surrounding spaces","expect":{"match":true,"normalized":"café"}},
    {"id":"wildcards","given":{"labels":["100%_\\","100aaa"]},"when":"search literal %_\\","expect":{"labels":["100%_\\"]}},
    {"id":"visibility","given":{"public":"cat","privateGroup":"cathedral","caller":"guest"},"when":"search cat; suggest cat; trend 24h","expect":{"visible":["cat"],"hiddenCounts":0,"hiddenHighlights":0,"hiddenSuggestions":0,"hiddenTrends":0}},
    {"id":"block","given":{"publicMatches":4,"blockedByViewer":1,"blockedViewer":1,"muted":1},"when":"search q=cat limit=1","expect":{"visibleCount":1,"next_cursor":null}},
    {"id":"revocation","given":{"cursorFrom":"before group removal"},"when":"continue after membership revoked","expect":{"hiddenReturned":0}},
    {"id":"privacy-sensitive-trend","given":{"privateOnlyQuery":"project-alpha"},"when":"logged-in search then guest trending","expect":{"historyWrites":1,"trendEvents":0}},
    {"id":"suggestions","given":{"labels":["Cat","cat","CATalyst","scatter"]},"when":"suggest q=cat","expect":{"texts":["Cat","CATalyst"],"historyWrites":0}},
    {"id":"rolling-window","given":{"now":"2026-11-28T12:00:00Z","term":"cat","ageSeconds":[86400,86399,604799,604800]},"when":"trending 24h then 7d","expect":{"counts":[1,3]}},
    {"id":"trend-tie","given":{"eligible":{"cat":2,"bat":2}},"when":"trending","expect":{"terms":["bat","cat"]}},
    {"id":"owner","given":{"A":["cat"],"B":["cat","owl"]},"when":"A deletes q=Cat twice then B lists history","expect":{"deleted":[1,0],"B":["cat","owl"]}},
    {"id":"clear","given":{"A":["cat","owl"],"B":["dog"]},"when":"A deletes clear=true twice","expect":{"deleted":[2,0],"B":["dog"]}},
    {"id":"history-tie","given":{"A":[["owl","T"],["cat","T"]]},"when":"history limit=1 then continue","expect":{"pages":[["cat"],["owl"]]}},
    {"id":"concurrent-upsert","given":{"A":[]},"when":"three backends first page submissions of Cat, CAT and cat concurrently","expect":{"rowsForA":1,"normalized":"cat"}},
    {"id":"zero-hit","given":{"A":[]},"when":"authenticated first-page search no hits","expect":{"status":200,"historyWrites":1,"trendEvents":0}},
    {"id":"anonymous","given":{"historyTable":false},"when":"guest search valid q","expect":{"status":200,"historyWrites":0}},
    {"id":"missing-table","given":{"historyTable":false},"when":"signed-in initial search, history GET, history DELETE","expect":{"status":503,"code":50301,"ddl":0,"trendEvents":0}},
    {"id":"unrelated-read","given":{"historyTable":false},"when":"continuation, suggestions, trending with available Redis","expect":{"status":200,"ddl":0}},
    {"id":"quota","given":{"tier":"exhausted"},"when":"search or delete history","expect":{"status":429,"code":42901,"historyWrites":0,"trendEvents":0,"headers":["RateLimit-Limit","RateLimit-Remaining","RateLimit-Reset","Retry-After"]}},
    {"id":"unauthorized","given":{"credentials":null},"when":"GET or DELETE history","expect":{"status":401}},
    {"id":"forbidden","given":{"credentials":"forbidden account"},"when":"search","expect":{"status":403}},
    {"id":"tampered-cursor","given":{"validCursor":true},"when":"change signature, viewer, type, term, limit or endpoint","expect":{"status":400,"historyWrites":0}},
    {"id":"boundaries","given":{},"when":"q size 1/100 scalar values; limit 1/50","expect":{"status":200}},
    {"id":"invalid-params","given":{},"when":"q empty, blank, or 101 scalars; limit=0,51,1.5; invalid type/window; duplicate q","expect":{"status":400}},
    {"id":"guard-delete","given":{"A":["cat"]},"when":"omit selector; q with clear; clear=false; add user_id","expect":{"status":400,"A":["cat"]}},
    {"id":"cursor-golden-search","given":{"keyBytes":"public fixture: integers 0 through 31 in order","payloadUtf8":"[1,\"search\",\"guest\",\"café<&\",\"all\",2,[\"posts\",0,\"10\"]]","token":"WzEsInNlYXJjaCIsImd1ZXN0IiwiY2Fmw6k8JiIsImFsbCIsMixbInBvc3RzIiwwLCIxMCJdXQ.z-Mpn_5UvhKENq_yPR2SVqn2tPfe5wQb2jgGaT4Dcfo"},"when":"each backend consumes the supplied token with its bound viewer, resource, matching key, type and limit","expect":{"accepted":true,"lastKey":["posts",0,"10"],"historyWrites":0}},
    {"id":"cursor-golden-history","given":{"keyBytes":"public fixture: integers 0 through 31 in order","payloadUtf8":"[1,\"history\",\"42\",\"\",\"all\",1,[\"2026-11-28T12:00:00.123456Z\",\"猫\"]]","token":"WzEsImhpc3RvcnkiLCI0MiIsIiIsImFsbCIsMSxbIjIwMjYtMTEtMjhUMTI6MDA6MDAuMTIzNDU2WiIsIueMqyJdXQ.hjSdKCFHlZ-v5LHknG-PKwLDHd4wvwJENWKwqPQ4r6A"},"when":"each backend consumes the supplied token with its bound viewer, resource, matching key, type and limit","expect":{"accepted":true,"lastKey":["2026-11-28T12:00:00.123456Z","猫"],"historyWrites":0}},
    {"id":"cursor-golden-escaped","given":{"keyBytes":"public fixture: integers 0 through 31 in order","payloadUtf8":"[1,\"search\",\"guest\",\"café\\u003c&\",\"all\",2,[\"posts\",0,\"10\"]]","token":"WzEsInNlYXJjaCIsImd1ZXN0IiwiY2Fmw6lcdTAwM2MmIiwiYWxsIiwyLFsicG9zdHMiLDAsIjEwIl1d.vjuLvjFaZf2zyAWoJvn_8UZqh3PpZ8xZhyp1VElcfjo"},"when":"each backend consumes the supplied token with its bound viewer, resource, matching key, type and limit","expect":{"accepted":true,"lastKey":["posts",0,"10"],"historyWrites":0}},
    {"id":"cursor-wrong-binding","given":{"tokenFrom":"cursor-golden-search","validBinding":["guest","search","café<&","all",2]},"when":"change viewer, resource, matching key, type or limit one at a time; separately use a different 32-byte key or change last ID without resigning","expect":{"status":400,"historyWrites":0,"trendEvents":0}},
    {"id":"cursor-server-pairs","given":{"servers":["nuxt","go","rust"],"resources":["search","history"],"searchSeed":"sections","historySeed":"history-tie"},"when":"for each resource each server issues the first page; each of the other two consumes that token with identical bindings and unchanged visible data","expect":{"pairsPerResource":6,"pagesMatchSingleServer":true,"noDuplicates":true,"noOmissions":true}},
    {"id":"cursor-key-config","given":{"invalid":["missing","padded base64url","invalid alphabet","31 decoded bytes","33 decoded bytes"]},"when":"enable global search for each invalid configuration; independently start with global search inactive and no key","expect":{"enabled":"explicit deployment configuration error","inactive":"startup allowed"}},
    {"id":"trend-shared-retry","given":{"key":"neko:v2:search:trending:1","nowMs":1800000000000,"source":["posts","2"],"publicLabel":"Cat","q":"CAT","members":["[\"00000000-0000-4000-8000-000000000001\",\"cat\",\"posts\",\"2\"]","[\"00000000-0000-4000-8000-000000000002\",\"cat\",\"posts\",\"2\"]"]},"when":"rotate Nuxt, Go and Rust as first writer, second writer and reader: two successful requests at nowMs; at nowMs+1 replay the first write with its frozen score and exact member bytes","expect":{"storedScores":[1800000000000,1800000000000],"members":2,"readerCounts":{"cat":2}}},
    {"id":"trend-window-ms","given":{"nowMs":1800000000000,"offsetMs":[-604800000,-604799999,-86400000,-86399999,0,1],"term":"cat","distinctEvents":true,"allSourcesPublic":true},"when":"read 24h then 7d at the same Redis time using another backend","expect":{"includedOffsets24h":[-86399999,0],"includedOffsets7d":[-604799999,-86400000,-86399999,0],"counts":[2,4]}},
    {"id":"trend-source-recheck","given":{"previous":"trend-shared-retry"},"when":"after writes, independently make the attributed source private, remove its literal match, or block it for the reader; query with that reader on another backend","expect":{"returnedTerms":[],"countedEvents":0}},
    {"id":"history-readiness-shape","given":{"catalog":"GLOBAL-SEARCH-SCHEMA-CATALOG","oracle":["19c","23 Free"],"valid":["declared schema","descending key exposed via SYS_NC and dictionary expression for UPDATED_AT"],"invalid":["FK references wrong table","FK references wrong column","FK delete rule differs","owner/term index nonunique","recent index columns reversed","recent second key ASC","SYS_NC expression refers to wrong column"]},"when":"check each variant independently through authenticated first-page search, history GET and history DELETE","expect":{"validStatus":200,"invalidStatus":503,"invalidCode":50301,"requestDdl":0,"invalidTrendEvents":0}}
  ]
}
