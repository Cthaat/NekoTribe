# Disposable FULL STACK only. Copy to .env.test; never use development data here.
COMPOSE_PROJECT_NAME=nekotribe-test
APP_BIND_ADDRESS=127.0.0.1
DEPENDENCY_BIND_ADDRESS=127.0.0.1
APP_PORT=31001
NGINX_PORT=31002
HOST=127.0.0.1
PORT=31000
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://127.0.0.1:30004,http://localhost:30004
CORS_ALLOW_LOCALHOST_ORIGINS=false
ACCESS_SECRET=replace-with-a-separate-random-test-access-secret
REFRESH_SECRET=replace-with-a-separate-random-test-refresh-secret
ACCESS_EXPIRES_IN=900
REFRESH_EXPIRES_IN=2592000
ORACLE_IMAGE=container-registry.oracle.com/database/enterprise:19.3.0.0
ORACLE_HOST=127.0.0.1
ORACLE_PORT=15511
ORACLE_SID=
ORACLE_SERVICE_NAME=ORCLPDB1
ORACLE_USER=neko_app
# Fixed development baseline schema password, not a production credential.
ORACLE_PASSWORD="replace-with-oracle-password"
ORACLE_PWD=NekoTestOnly2026
ORACLE_SYS_SERVICE_NAME=ORCLCDB
ORACLE_PDB_NAME=ORCLPDB1
ORACLE_HOST_PORT=15511
ORACLE_EM_PORT=15512
# Named volumes are scoped to COMPOSE_PROJECT_NAME. Never use ../data/oracle-data.
ORACLE_DATA_VOLUME=oracle-data
ORACLE_DATA_MOUNT_OPTIONS=
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=3
ORACLE_POOL_INCREMENT=1
DOCKER_ORACLE_HOST=oracle19c
DOCKER_ORACLE_PORT=1521
DOCKER_NODE_ENV=production
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_URL=
REDIS_DB=0
REDIS_PASSWORD=NekoTestCacheOnly2026
DOCKER_REDIS_HOST=redis
DOCKER_REDIS_PORT=6379
DOCKER_REDIS_URL=redis://redis:6379
STORAGE_ROOT_DIR=./.test-data/storage
STORAGE_PATH=./.test-data/storage
DOCKER_STORAGE_PATH=/app/storage
STORAGE_TYPE=local
STORAGE_PUBLIC_BASE=/storage
BASE_URL=
NUXT_PUBLIC_API_BASE=
NUXT_PUBLIC_WS_URL=
NUXT_PUBLIC_STORAGE_BASE=
DOCKER_PUBLIC_WS_URL=
SENTIMENTFLOW_MODELS_HOST_DIR=./.test-data/models
DB_INIT_ALLOW_EMPTY=false
DB_INIT_CHECK_TABLE=N_USERS
