# Inject variables into the process; cargo run does not load .env automatically.
HOST=127.0.0.1
RUST_BACKEND_PORT=30003
# Native is the default. Use compat explicitly for the legacy Nuxt proxy.
RUST_BACKEND_MODE=native
# Native mode: match Nuxt/Go keys respectively. Access and refresh should use
# different keys; each framework must share the same corresponding key.
ACCESS_SECRET=replace-with-shared-access-key
REFRESH_SECRET=replace-with-shared-refresh-key
ACCESS_EXPIRES_IN=900
REFRESH_EXPIRES_IN=2592000
CORS_ALLOWED_ORIGINS=http://localhost:30004,http://127.0.0.1:30004,http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_LOCALHOST_ORIGINS=false
RUST_BACKEND_DOCKER=false
COOKIE_SECURE=false
# Match Nuxt/Go moderation authorization; keep bypass disabled in ordinary use.
MODERATION_ADMIN_ACCOUNTS=
MODERATION_ALLOW_ALL=false
# OTP email uses implicit TLS; supply a real SMTP app password only in the process environment.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Public URL mapping for login avatars; match Nuxt. Do not use /, // prefixes,
# or usernames/passwords in the public base URLs.
STORAGE_PUBLIC_BASE=/storage
# Required when STORAGE_TYPE=s3. Use a dedicated bucket and path-style S3 endpoint.
STORAGE_TYPE=local
STORAGE_S3_ENDPOINT=
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_SESSION_TOKEN=
BASE_URL=
STORAGE_CDN_BASE_URL=
# Optional ffprobe executable path for audio/video metadata. Empty uses PATH.
FFPROBE_PATH=
# Optional AI writing model routing JSON; inject credentials separately by environment variable.
# Native mode snapshots this configuration at process startup; restart to change it.
AI_MODEL_CONFIG_JSON=
AI_MODEL_CONFIG_FILE=
# Match the limits in all backends sharing the same Redis database.
# AI_QUOTA_ACTOR_PER_MINUTE=20
# AI_QUOTA_SERVICE_PER_MINUTE=120
# Optional shared semantic search service. The token must match the service.
AI_KNOWLEDGE_INDEX_URL=
AI_KNOWLEDGE_INDEX_FALLBACK=
AI_INDEX_SERVICE_TOKEN=
# Enable only behind a trusted reverse proxy.
TRUST_PROXY=false
LEGACY_BACKEND_BASE_URL=http://127.0.0.1:30001
# Set Docker addresses for your existing network; no services are provisioned here.
DOCKER_LEGACY_BACKEND_BASE_URL=http://host.docker.internal:30001
# Compose host publishing only; container always listens on 0.0.0.0:8080.
RUST_PUBLISH_HOST=127.0.0.1
RUST_PUBLISH_PORT=30003
ORACLE_HOST=127.0.0.1
ORACLE_PORT=5501
ORACLE_SERVICE_NAME=ORCLPDB1
ORACLE_USER=neko_app
ORACLE_PASSWORD=
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=10
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
RUST_LOG=nekotribe_backend=info,tower_http=info
