# Explicit environment only. This process does not load .env files.
HOST=127.0.0.1
GO_BACKEND_PORT=30006
# Match Nuxt/Rust access and refresh keys respectively; use different keys for
# access versus refresh, not different keys for each framework.
ACCESS_SECRET=replace-with-shared-access-key
REFRESH_SECRET=replace-with-shared-refresh-key
ACCESS_EXPIRES_IN=900
REFRESH_EXPIRES_IN=2592000

# Optional Passkeys. Set both values and apply the explicit schema migration.
# Use comma-separated HTTPS origins, HTTP localhost or Android APK signing origins.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGINS=
# Optional GitHub login. Apply the explicit schema migration and register the
# same HTTPS /api/v2/auth/oauth/github/callback URL with the GitHub OAuth app.
# HTTP localhost is supported for development.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=
# Optional private Prometheus scrape at /metrics. Keep it off public ingress
# and use protected transport for the bearer token. Empty disables scraping.
METRICS_TOKEN=
# Set to true for HTTPS deployments.
COOKIE_SECURE=false
# Match Nuxt moderation authorization. Keep bypass disabled in ordinary use.
MODERATION_ADMIN_ACCOUNTS=
MODERATION_ALLOW_ALL=false
# Server-controlled model configuration JSON; see Nuxt docs/ai-writing-development.md.
AI_MODEL_CONFIG_JSON=
AI_MODEL_CONFIG_FILE=
# Match the limits in all backends sharing the same Redis database.
# AI_QUOTA_ACTOR_PER_MINUTE=20
# AI_QUOTA_SERVICE_PER_MINUTE=120
# Optional shared semantic search service. The token must match the service.
AI_KNOWLEDGE_INDEX_URL=
AI_KNOWLEDGE_INDEX_FALLBACK=
AI_INDEX_SERVICE_TOKEN=
# OTP email uses implicit TLS; supply a real SMTP app password only in the process environment.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Public URL mapping for login avatars; match Nuxt. Do not use /, // prefixes,
# or usernames/passwords in the public base URLs.
STORAGE_PUBLIC_BASE=/storage
# Required when STORAGE_TYPE=s3. Use a dedicated bucket and path-style S3 endpoint.
STORAGE_TYPE=local
STORAGE_S3_ENDPOINT=
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_SESSION_TOKEN=
# Optional executable path; otherwise ffprobe is looked up on PATH.
FFPROBE_PATH=
BASE_URL=
STORAGE_CDN_BASE_URL=
# Trust X-Forwarded-For only behind a trusted reverse proxy.
TRUST_PROXY=false
# Optional shared canonical IP to region snapshot. Deploy identical values on all backends.
# NEKO_LOGIN_REGION_MAP='{"192.0.2.8":"A","2001:db8::1":"B"}'
ORACLE_HOST=127.0.0.1
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=FREEPDB1
ORACLE_USER=replace-with-app-user
ORACLE_PASSWORD=replace-with-password
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=10
# The native notification socket subscribes to this shared Redis instance.
# Use rediss:// for TLS. Supply real credentials only via the environment.
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CORS_ALLOWED_ORIGINS=http://localhost:30004,http://127.0.0.1:30004,http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_LOCALHOST_ORIGINS=false
