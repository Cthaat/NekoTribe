# One public origin: switch API backend without changing clients or cookies.
map $http_upgrade $neko_connection_upgrade {
    default upgrade;
    '' close;
}

map $http_host $neko_public_host {
    default $http_host;
    '' $host;
}

server {
    listen 80;
    server_name _;
    client_max_body_size 64m;
    # Query strings can contain WebSocket tokens; do not log them.
    access_log off;

    proxy_http_version 1.1;
    proxy_set_header Host $neko_public_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    location ~ ^/api/v2/media(/private)?$ {
        # 500 MiB of files, up to 20 MiB of fields, plus multipart framing.
        client_max_body_size 528m;
        proxy_request_buffering off;
        proxy_read_timeout 360s;
        proxy_pass ${API_BACKEND_UPSTREAM};
    }
    location ~ ^/api/v2/media/[^/]+/content$ {
        proxy_buffering off;
        proxy_pass ${API_BACKEND_UPSTREAM};
    }
    location /api/ {
        proxy_pass ${API_BACKEND_UPSTREAM};
    }
    location /storage/ {
        limit_except GET OPTIONS { deny all; }
        proxy_pass ${MEDIA_BACKEND_UPSTREAM};
        proxy_set_header Host $neko_public_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
    }
    location /uploads/ {
        proxy_pass ${API_BACKEND_UPSTREAM};
    }
    location /upload/ {
        proxy_pass ${API_BACKEND_UPSTREAM};
    }
    location = /_ws {
        # Upstream error messages can include the token-bearing request URI.
        error_log /dev/null;
        proxy_pass ${WS_BACKEND_UPSTREAM};
        proxy_set_header Host $neko_public_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $neko_connection_upgrade;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
    location / {
        proxy_pass ${UI_NUXT_UPSTREAM};
    }
}
