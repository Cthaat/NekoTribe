# Copy to .env.knowledge-index-updater and fill the deployment's values.
# This process reads public source snapshots from Oracle and writes to Qdrant.
AI_INDEX_ORACLE_USER=
AI_INDEX_ORACLE_PASSWORD=
AI_INDEX_ORACLE_CONNECT=
AI_INDEX_QDRANT_URL=http://host.docker.internal:6333
AI_INDEX_QDRANT_KEY=

# Set the credential named by keyEnv in the active profile, if required.
AI_EMBEDDING_KEY_LOCAL=
# Seconds after a successful sync and the upper bound for failure retries.
AI_INDEX_SYNC_SECONDS=900
AI_INDEX_AUTO_PRUNE=0
